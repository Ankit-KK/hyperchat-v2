# Step-up (passkey) verifier: /etc/hyperchat-stepup/stepup.env (DEV) or /etc/hyperchat-prod-stepup/stepup.env
# (production), root:<verifier user> 0640. NO secrets of any kind: the verifier refuses to start when any other
# HYPERCHAT_* variable is present (app.stepup.config.ALLOWED_KEYS), so a copied api.env cannot run it.
HYPERCHAT_APP_ENV=development
HYPERCHAT_LOG_LEVEL=INFO
HYPERCHAT_DB_HOST=/var/run/postgresql
HYPERCHAT_DB_PORT=5433
HYPERCHAT_DB_NAME=hyperchat_dev
HYPERCHAT_DB_STEPUP_USER=hyperchat_stepup
HYPERCHAT_DB_LABEL=DEV
HYPERCHAT_WEBAUTHN_RP_ID=quicktestspace.site
HYPERCHAT_WEBAUTHN_RP_NAME=HyperChat (DEV)
HYPERCHAT_WEBAUTHN_ORIGINS=https://app.quicktestspace.site
# PDP v2.0 G4: once the admin app is on its own host, passkey ceremonies must only complete there. Before the first
# passkey is enrolled, in an approved window, replace the value above with the admin host (it must stay within the
# RP ID, which does not change; docs/admin-stepup.md "Admin host (PDP v2.0 G4)"):
# HYPERCHAT_WEBAUTHN_ORIGINS=https://admin.quicktestspace.site
