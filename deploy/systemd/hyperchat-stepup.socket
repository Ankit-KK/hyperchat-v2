# DEV step-up (passkey) verifier socket. Created by systemd as hyperchat-stepup:hyperchat 0660: only the API's OS user (hyperchat) and
# root can connect; the verifier receives it as fd 3 (uvicorn --fd 3). Nothing listens on the network.
[Unit]
Description=HyperChat v2 step-up verifier socket (DEV)

[Socket]
ListenStream=/run/hyperchat-stepup.sock
SocketUser=hyperchat-stepup
SocketGroup=hyperchat
SocketMode=0660
Accept=no

[Install]
WantedBy=sockets.target
