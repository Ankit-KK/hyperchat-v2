# Step-up (passkey) verifier: /etc/hyperchat-stepup/stepup.env (DEV) or /etc/hyperchat-prod-stepup/stepup.env
# (production), root:<verifier user> 0640. NO secrets of any kind: the verifier refuses to start when any other
# HYPERCHAT_* variable is present (app.stepup.config.ALLOWED_KEYS), so a copied api.env cannot run it.
HYPERCHAT_APP_ENV=production
HYPERCHAT_LOG_LEVEL=INFO
HYPERCHAT_DB_HOST=/var/run/postgresql
HYPERCHAT_DB_PORT=5432
HYPERCHAT_DB_NAME=hyperchat
HYPERCHAT_DB_STEPUP_USER=hyperchat_stepup
HYPERCHAT_DB_LABEL=PRODUCTION
HYPERCHAT_WEBAUTHN_RP_ID=hyperchat.space
HYPERCHAT_WEBAUTHN_RP_NAME=HyperChat
HYPERCHAT_WEBAUTHN_ORIGINS=https://hyperchat.space
