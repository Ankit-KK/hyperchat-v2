# HyperChat v2 API - environment template for /etc/hyperchat/api.env on the VPS
# (root:hyperchat, mode 0640). Copy, then fill in on the server. Never commit the real file.
# Values below describe the v2 DEVELOPMENT environment (api.quicktestspace.site).

HYPERCHAT_APP_ENV=development
HYPERCHAT_LOG_LEVEL=INFO
HYPERCHAT_ENABLE_DOCS=false

# ── Database ────────────────────────────────────────────────────────────────────
# Unix-socket directory -> peer authentication (OS user "hyperchat" -> role hyperchat_app via
# pg_ident); no database password exists.
HYPERCHAT_DB_ENABLED=true
HYPERCHAT_DB_HOST=/var/run/postgresql
# Development: hyperchat_dev on cluster 15/restoretest (5433), loaded by database/etl/rehearsal.py.
# Production (later): hyperchat on cluster 17/hyperchat (5432).
HYPERCHAT_DB_PORT=5433
HYPERCHAT_DB_NAME=hyperchat_dev
HYPERCHAT_DB_USER=hyperchat_app
# HYPERCHAT_DB_PASSWORD=   (only for TCP/password auth; leave unset with peer auth)
# Shown in logs and in /health on the server itself (127.0.0.1 only; public callers get the status only).
# The app refuses to start with APP_ENV=production if it contains TEST or DEV.
HYPERCHAT_DB_LABEL=DEV hyperchat_dev (HyperChat v2 development environment)
HYPERCHAT_DB_POOL_MIN=1
HYPERCHAT_DB_POOL_MAX=4

# ── Authentication (app.auth). Leave AUTH_SECRET unset to keep auth disabled (503). ──
# Generate per environment on the server (never reuse between dev and production), e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# HYPERCHAT_AUTH_SECRET=
# The DEVELOPMENT frontend (reset/invite links point here). Never the production site
# https://hyperchat.space: the development API must not trust it.
HYPERCHAT_FRONTEND_URL=https://app.quicktestspace.site
# Browser origins trusted with credentials = the frontend's origin + this comma-separated list of exact
# origins (no wildcards). Plain http only for localhost; the app refuses development origins in production.
HYPERCHAT_ALLOWED_ORIGINS=http://localhost:5173
# Production (api.hyperchat.space + hyperchat.space are same-site): lax; the app refuses "none" there.
# Development only: "none" lets a frontend on another site (e.g. http://localhost:5173 -> the dev API)
# send the session cookie; only the exact origins above are ever trusted.
HYPERCHAT_SESSION_COOKIE_SAMESITE=lax
HYPERCHAT_SESSION_IDLE_DAYS=7
HYPERCHAT_SESSION_ABSOLUTE_DAYS=30
HYPERCHAT_AUTH_RETURN_INVITE_LINKS=false
# Email: "disabled" logs only the template name (never the link); "resend" sends via the Resend API.
HYPERCHAT_EMAIL_BACKEND=disabled
# HYPERCHAT_RESEND_API_KEY=
HYPERCHAT_EMAIL_FROM=HyperChat <no-reply@hyperchat.space>
# Google sign-in is enabled only when all three are set.
# HYPERCHAT_GOOGLE_CLIENT_ID=
# HYPERCHAT_GOOGLE_CLIENT_SECRET=
# HYPERCHAT_GOOGLE_REDIRECT_URI=https://api.quicktestspace.site/api/v1/auth/google/callback

# ── Server-to-server security (app.security); unset = the mechanism rejects everything ──
# HYPERCHAT_UPLOAD_GRANT_SECRET=

# ── Cloudflare R2 (app.storage): donor uploads answer 503 until all of these are set and valid.
#    DEVELOPMENT bucket only (hyperchat-dev-media), with an API token scoped to that one bucket
#    (Object Read & Write). Never the legacy production bucket. Values are set on the server only.
# HYPERCHAT_R2_ACCOUNT_ID=
# HYPERCHAT_R2_ACCESS_KEY_ID=
# HYPERCHAT_R2_SECRET_ACCESS_KEY=
# HYPERCHAT_R2_BUCKET=
# Public read base of the bucket (https, e.g. the bucket's r2.dev URL); object URLs are built from it.
# HYPERCHAT_R2_PUBLIC_BASE_URL=
# Optional: S3 API endpoint (default https://<account id>.r2.cloudflarestorage.com)
# HYPERCHAT_R2_ENDPOINT=

# ── Razorpay (app.payments): up to two accounts; each creator uses the one in streamers.razorpay_account
#    (primary | secondary). Checkout for an account answers "on hold" until its key id and key secret are
#    set; its webhooks answer 401 until its webhook secret is set (Razorpay Dashboard > Webhooks, the
#    secret entered there). DEVELOPMENT uses Razorpay TEST MODE only: the app refuses to start with a
#    live key id (rzp_live_...) unless HYPERCHAT_APP_ENV=production. Values are set on the server only.
#    Webhook URL (test mode): https://api.quicktestspace.site/api/v1/webhooks/razorpay
#    Events: payment.captured, payment.failed
# HYPERCHAT_RAZORPAY_PRIMARY_KEY_ID=
# HYPERCHAT_RAZORPAY_PRIMARY_KEY_SECRET=
# HYPERCHAT_RAZORPAY_PRIMARY_WEBHOOK_SECRET=
# HYPERCHAT_RAZORPAY_SECONDARY_KEY_ID=
# HYPERCHAT_RAZORPAY_SECONDARY_KEY_SECRET=
# HYPERCHAT_RAZORPAY_SECONDARY_WEBHOOK_SECRET=

# ── Background worker and donation audio (Phase 8: app.jobs, app.audio; hyperchat-worker.service) ──
#    Paid providers are OFF unless HYPERCHAT_AUDIO_PROVIDERS_ENABLED=true AND the provider key is set:
#    while off, every donation alert gets the silent fallback and transcription answers 503. Enable on
#    DEV only deliberately, for a manual provider smoke test. No production values here.
# HYPERCHAT_AUDIO_PROVIDERS_ENABLED=false
# HYPERCHAT_MINIMAX_API_KEY=
# HYPERCHAT_ELEVENLABS_API_KEY=
# HYPERCHAT_SARVAM_API_KEY=
# HMAC key pseudonymising supporter names in tts_moderation_audit (any long random string, per environment).
# Without it the moderation guard fails closed: no provider call, silent audio.
# HYPERCHAT_TTS_MODERATION_HASH_KEY=
# Worker job slots (1-16).
# HYPERCHAT_WORKER_CONCURRENCY=2
# MiniMax voice used when a creator has neither a MiniMax voice nor an ElevenLabs voice (decision D4).
# HYPERCHAT_MINIMAX_DEFAULT_VOICE_ID=moss_audio_3e9334b7-e32a-11f0-ba34-ee3bcee0a7c9

# ── Realtime (Phase 9: app.realtime) ─────────────────────────────────────────────────────────
#    Events are always written to public.realtime_outbox with the change that caused them; the worker
#    publishes them to Pusher only when HYPERCHAT_REALTIME_ENABLED=true and the creator's Pusher group
#    (streamers.pusher_group) is configured. Unconfigured groups (and groups 5-10) use group 1. While off,
#    events are marked 'skipped' and /api/v1/realtime/* answers 503.
#    DEV uses its OWN Pusher app, created for DEV only: never the legacy/production Pusher credentials (the DEV
#    database holds real creator slugs, so legacy apps would push into real streamers' live overlays).
# HYPERCHAT_REALTIME_ENABLED=false
# HYPERCHAT_PUSHER_APP_ID_1=
# HYPERCHAT_PUSHER_KEY_1=
# HYPERCHAT_PUSHER_SECRET_1=
# HYPERCHAT_PUSHER_CLUSTER_1=
# (and _2, _3, _4 for further Pusher apps)
# Pusher messages per second per worker process (1-1000).
# HYPERCHAT_REALTIME_PUBLISH_RATE=50

# ── OBS audio (Phase 10: app.obs) ─────────────────────────────────────────────────────────────
#    Creators whose "!vaani" donations play the celebration instead of an alert (comma-separated slugs;
#    legacy default ankit,captain_vaani; empty = nobody).
# HYPERCHAT_VAANI_CREATORS=ankit,captain_vaani

# ── Moderation bots (Phase 11: app.bots) ──────────────────────────────────────────────────────
#    OFF by default. DEV uses its OWN test bot / application: never the legacy @hyperChat_modbot or the legacy
#    Discord application (their webhooks must not be re-pointed). Outside production only the ids listed in
#    HYPERCHAT_BOT_RECIPIENT_ALLOWLIST receive messages (the DEV database holds real moderators' ids).
# HYPERCHAT_BOTS_ENABLED=false
# HYPERCHAT_TELEGRAM_BOT_TOKEN=
# HYPERCHAT_TELEGRAM_WEBHOOK_SECRET=
# HYPERCHAT_DISCORD_BOT_TOKEN=
# HYPERCHAT_DISCORD_PUBLIC_KEY=
# HYPERCHAT_DISCORD_APPLICATION_ID=
# Comma-separated Telegram chat ids / Discord user or channel ids (non-production only).
# HYPERCHAT_BOT_RECIPIENT_ALLOWLIST=
# Comma-separated creator slugs the bots act for (non-production only; empty = none): notifications, commands
# (/pending, /recent, ...) and button presses. Use synthetic creators only, never real DEV creators.
# HYPERCHAT_BOT_CREATOR_ALLOWLIST=
