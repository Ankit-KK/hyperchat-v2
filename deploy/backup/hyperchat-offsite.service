[Unit]
Description=HyperChat off-site copy of the newest verified backup set (PRODUCTION; disabled until approved)
After=hyperchat-pgbackup.service
# Installed and enabled only after the owner approved the destination and credentials (docs/backup-recovery.md).
ConditionPathExists=/etc/hyperchat-backup/offsite-prod.env

[Service]
Type=oneshot
# The standalone backup tools tree (docs/backup-recovery.md), not a production release: app/backup/{sets,offsite}.py
# of a merged commit plus a venv with the boto3 closure, so production's off-site copy never waits for or changes
# with an API deploy. -B: no bytecode is written (the tree is also read-only under ProtectSystem=strict).
WorkingDirectory=/opt/hyperchat-backup-tools/current
# Root reads the root-only backup directory; the config (root 0600) holds the BACKUP storage credential, which is
# never the API's media credential and is never in api.env.
ExecStart=/opt/hyperchat-backup-tools/current/venv/bin/python -B -m app.backup.offsite upload --config /etc/hyperchat-backup/offsite-prod.env --latest
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Ciphertext and binding records of an unfinished upload (resumable; removed once the off-site set is complete).
StateDirectory=hyperchat-offsite/prod
StateDirectoryMode=0700
