[Unit]
Description=HyperChat PostgreSQL logical backup (DEV: hyperchat_dev on 15/restoretest)
After=postgresql@15-restoretest.service
Requires=postgresql@15-restoretest.service

[Service]
Type=oneshot
# The same installed script as production, DEV profile: its own database, cluster tools (15), directory
# (/var/backups/hyperchat-dev) and witness. docs/backup-recovery.md.
Environment=HYPERCHAT_BACKUP_ENV=dev
ExecStart=/usr/local/sbin/hyperchat-pgbackup
Nice=10
IOSchedulingClass=idle
UMask=0077
# S7 sandbox: writes only its own backup directory; reads the witness and the PostgreSQL socket. PrivateTmp gives a
# private writable /tmp (the retention check's heredoc may use one). sudo to postgres under NoNewPrivileges is checked
# by a transient-unit probe before this unit is installed on a server (docs/backup-recovery.md).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/hyperchat-dev
PrivateTmp=yes
ProtectHome=yes
