# Off-site backup copy (app.backup.offsite; docs/backup-recovery.md). Template for
#   /etc/hyperchat-backup/offsite-prod.env   and   /etc/hyperchat-backup/offsite-dev.env
# root:root, mode 0600 (the tool refuses anything else), directory /etc/hyperchat-backup root 0700.
# DISABLED until the owner approves the destination, the credentials and the encryption key (open decisions in the
# docs). No value belongs in the repository. Never reuse the API's R2 media credential or bucket.

HYPERCHAT_OFFSITE_ENABLED=false
# prod or dev; the object prefix must equal it, so the two environments never share a namespace.
HYPERCHAT_OFFSITE_ENVIRONMENT=
HYPERCHAT_OFFSITE_PREFIX=
# S3-compatible HTTPS endpoint (e.g. https://<account>.r2.cloudflarestorage.com) and the BACKUP bucket.
HYPERCHAT_OFFSITE_ENDPOINT=
HYPERCHAT_OFFSITE_BUCKET=
# A token scoped to that bucket only (object read + write). Deletion is prevented by the bucket's object lock /
# retention rule, which the owner configures in the storage console; this tool never deletes.
HYPERCHAT_OFFSITE_ACCESS_KEY_ID=
HYPERCHAT_OFFSITE_SECRET_ACCESS_KEY=
# The owner's GPG PUBLIC key (armored), e.g. /etc/hyperchat-backup/backup-recipient.asc. The private key never
# comes to this server: it is kept offline by the owner and needed for every restore from off-site.
HYPERCHAT_OFFSITE_GPG_RECIPIENT_FILE=
