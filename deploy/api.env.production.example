# HyperChat v2 API - PRODUCTION environment template for /etc/hyperchat-prod/api.env on the VPS
# (root:hyperchat-prod, mode 0640, directory /etc/hyperchat-prod mode 0750). Copy, then fill in ON THE
# SERVER. Never commit the real file, never copy any secret from the DEV file (/etc/hyperchat/api.env).
# The app refuses to start in production with a TEST/DEV database label, a development origin
# (e.g. http://localhost:...) or SameSite=None.

HYPERCHAT_APP_ENV=production
HYPERCHAT_LOG_LEVEL=INFO
HYPERCHAT_ENABLE_DOCS=false

# ── Database: hyperchat on cluster 17/hyperchat (5432), Unix socket + peer authentication ─────────
# OS user hyperchat-prod -> role hyperchat_app via the production ident map
# (deploy/postgres/pg_ident.production.conf). No database password exists.
HYPERCHAT_DB_ENABLED=true
HYPERCHAT_DB_HOST=/var/run/postgresql
HYPERCHAT_DB_PORT=5432
HYPERCHAT_DB_NAME=hyperchat
HYPERCHAT_DB_USER=hyperchat_app
# HYPERCHAT_DB_PASSWORD=   (only for TCP/password auth; leave unset with peer auth)
# Creator status transitions (KYC PR4) run on their own role, which may only execute kyc_change_creator_status
# (deploy/postgres/roles.sql + the pg_ident map). Unset: admin activate / suspend / reactivate answer 503.
HYPERCHAT_DB_LIFECYCLE_USER=hyperchat_lifecycle
# Authentication flows (migration 0024) run on their own role: hyperchat_app cannot write admin credentials or
# sessions. Required: without it administrators cannot sign in.
HYPERCHAT_DB_AUTH_USER=hyperchat_auth
# S2: the step-up (passkey) verifier's socket (deploy/systemd/*-stepup.socket). Uncomment ONLY after the
# verifier is installed (docs/admin-stepup.md); unset, the passkey endpoints answer 503 (admin access is
# unchanged while MFA enforcement is draft).
# HYPERCHAT_STEPUP_SOCKET=/run/hyperchat-prod-stepup.sock
HYPERCHAT_DB_LABEL=PROD hyperchat (HyperChat v2 production)
HYPERCHAT_DB_POOL_MIN=1
HYPERCHAT_DB_POOL_MAX=4

# ── Authentication ──────────────────────────────────────────────────────────────
# Generated ON THE SERVER when the file is created (never the DEV value), e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset = authentication disabled (503).
# HYPERCHAT_AUTH_SECRET=
HYPERCHAT_FRONTEND_URL=https://hyperchat.space
# Extra exact https origins only (no localhost, no wildcards). Add https://www.hyperchat.space here
# only if the frontend is ever served there.
HYPERCHAT_ALLOWED_ORIGINS=
# D5: contact details shown by the frontend (GET /api/v1/public/config). PUBLIC values, never secrets; unset =
# null. The API refuses to start on a malformed value. Phones: comma-separated, at most 5. Discord: an invite
# URL (https://discord.gg/<code> or https://discord.com/invite/<code>).
# HYPERCHAT_PUBLIC_CONTACT_NAME=
# HYPERCHAT_PUBLIC_CONTACT_EMAIL=
# HYPERCHAT_PUBLIC_CONTACT_PHONES=
# HYPERCHAT_PUBLIC_DISCORD_URL=
# api.hyperchat.space and hyperchat.space are same-site: lax (the app refuses "none" in production).
HYPERCHAT_SESSION_COOKIE_SAMESITE=lax
HYPERCHAT_SESSION_IDLE_DAYS=7
HYPERCHAT_SESSION_ABSOLUTE_DAYS=30
# Administrators (docs/admin-stepup.md, post-S3 A4): enforced in the database on every request.
HYPERCHAT_ADMIN_SESSION_IDLE_HOURS=2
HYPERCHAT_ADMIN_SESSION_ABSOLUTE_HOURS=12
HYPERCHAT_AUTH_RETURN_INVITE_LINKS=false
# Email stays disabled until a production Resend key exists (then: resend + the key, set on the server).
HYPERCHAT_EMAIL_BACKEND=disabled
# HYPERCHAT_RESEND_API_KEY=
HYPERCHAT_EMAIL_FROM=HyperChat <no-reply@hyperchat.space>
# Google sign-in is enabled only when all three are set (production OAuth client, set on the server).
# HYPERCHAT_GOOGLE_CLIENT_ID=
# HYPERCHAT_GOOGLE_CLIENT_SECRET=
# HYPERCHAT_GOOGLE_REDIRECT_URI=https://api.hyperchat.space/api/v1/auth/google/callback

# ── Server-to-server security; unset = the mechanism rejects everything. Generate per environment. ──
# HYPERCHAT_UPLOAD_GRANT_SECRET=

# ── Razorpay (app.payments): one account, "primary" (D6), LIVE MODE only: the app refuses to start in
#    production with a test key id (rzp_test_...). Set at the production cutover, with approval.
#    Webhook URL: https://api.hyperchat.space/api/v1/webhooks/razorpay   Events: payment.captured, payment.failed
# HYPERCHAT_RAZORPAY_PRIMARY_KEY_ID=
# HYPERCHAT_RAZORPAY_PRIMARY_KEY_SECRET=
# HYPERCHAT_RAZORPAY_PRIMARY_WEBHOOK_SECRET=

# Didit identity verification (KYC; docs/kyc.md). Unset = KYC unavailable (503), everything else works.
# This environment's Didit application: live here (anything else refuses to start). The WEBHOOK SECRET is never in this file:
# it is stored in the database with database/etl/kyc_provider_config.py (docs/kyc.md), which verifies webhooks.
# HYPERCHAT_DIDIT_API_KEY=
# HYPERCHAT_DIDIT_WORKFLOW_ID=
# HYPERCHAT_DIDIT_ENVIRONMENT=live
# KYC enforcement restore witness (docs/kyc-rollout.md): an append-only file outside PostgreSQL, one per environment
# (chattr +a). Unset: only the untouched pre-rollout database is accepted; enforcement changes are refused.
# HYPERCHAT_KYC_WITNESS_PATH=/var/lib/hyperchat-kyc/prod.witness
