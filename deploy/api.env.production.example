# HyperChat v2 API - PRODUCTION environment template for /etc/hyperchat-prod/api.env on the VPS
# (root:hyperchat-prod, mode 0640, directory /etc/hyperchat-prod mode 0750). Copy, then fill in ON THE
# SERVER. Never commit the real file, never copy any secret from the DEV file (/etc/hyperchat/api.env).
# The app refuses to start in production with a TEST/DEV database label, a development origin
# (e.g. http://localhost:...) or SameSite=None.

HYPERCHAT_APP_ENV=production
HYPERCHAT_LOG_LEVEL=INFO
HYPERCHAT_ENABLE_DOCS=false

# ── Database: hyperchat on cluster 17/hyperchat (5432), Unix socket + peer authentication ─────────
# OS user hyperchat-prod -> role hyperchat_app via the production ident map
# (deploy/postgres/pg_ident.production.conf). No database password exists.
HYPERCHAT_DB_ENABLED=true
HYPERCHAT_DB_HOST=/var/run/postgresql
HYPERCHAT_DB_PORT=5432
HYPERCHAT_DB_NAME=hyperchat
HYPERCHAT_DB_USER=hyperchat_app
# HYPERCHAT_DB_PASSWORD=   (only for TCP/password auth; leave unset with peer auth)
HYPERCHAT_DB_LABEL=PROD hyperchat (HyperChat v2 production)
HYPERCHAT_DB_POOL_MIN=1
HYPERCHAT_DB_POOL_MAX=4

# ── Authentication ──────────────────────────────────────────────────────────────
# Generated ON THE SERVER when the file is created (never the DEV value), e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset = authentication disabled (503).
# HYPERCHAT_AUTH_SECRET=
HYPERCHAT_FRONTEND_URL=https://hyperchat.space
# Extra exact https origins only (no localhost, no wildcards). Add https://www.hyperchat.space here
# only if the frontend is ever served there.
HYPERCHAT_ALLOWED_ORIGINS=
# api.hyperchat.space and hyperchat.space are same-site: lax (the app refuses "none" in production).
HYPERCHAT_SESSION_COOKIE_SAMESITE=lax
HYPERCHAT_SESSION_IDLE_DAYS=7
HYPERCHAT_SESSION_ABSOLUTE_DAYS=30
HYPERCHAT_AUTH_RETURN_INVITE_LINKS=false
# Email stays disabled until a production Resend key exists (then: resend + the key, set on the server).
HYPERCHAT_EMAIL_BACKEND=disabled
# HYPERCHAT_RESEND_API_KEY=
HYPERCHAT_EMAIL_FROM=HyperChat <no-reply@hyperchat.space>
# Google sign-in is enabled only when all three are set (production OAuth client, set on the server).
# HYPERCHAT_GOOGLE_CLIENT_ID=
# HYPERCHAT_GOOGLE_CLIENT_SECRET=
# HYPERCHAT_GOOGLE_REDIRECT_URI=https://api.hyperchat.space/api/v1/auth/google/callback

# ── Server-to-server security; unset = the mechanism rejects everything. Generate per environment. ──
# HYPERCHAT_UPLOAD_GRANT_SECRET=
